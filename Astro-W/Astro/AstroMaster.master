.loading-mask {
    position: fixed; /* covers whole screen */
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255,255,255,0.7); /* semi-transparent */
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
}

.loading-text {
    font-size: 20px;
    font-weight: bold;
    color: #333;
}

    </style>
<style type="text/css">
.as_loaderIn {
    position: relative;
    width: 400px;
    height: 400px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0a0f1f;
    border-radius: 50%;
    overflow: hidden;
}

/* Sun */
.sun {
    position: absolute;
    width: 70px;
    height: 70px;
    background: radial-gradient(circle, #ffd54f, #ff9800);
    border-radius: 50%;
    box-shadow:
        0 0 20px #ff9800,
        0 0 40px #ff9800,
        0 0 60px #ff9800;
    z-index: 10;
}

/* Orbits */
.orbit {
    position: absolute;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    animation: rotate linear infinite;
}

/* Orbit Sizes */
.orbit-1 {
    width: 140px;
    height: 140px;
    animation-duration: 4s;
}

.orbit-2 {
    width: 240px;
    height: 240px;
    animation-duration: 8s;
}

.orbit-3 {
    width: 340px;
    height: 340px;
    animation-duration: 12s;
}

/* Planets */
.planet {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border-radius: 50%;
}

/* Planet Styles */
.planet-1 {
    width: 16px;
    height: 16px;
    background: #4fc3f7;
    left: -8px;
}

.planet-2 {
    width: 22px;
    height: 22px;
    background: #81c784;
    left: -11px;
}

.planet-3 {
    width: 28px;
    height: 28px;
    background: #ba68c8;
    left: -14px;
}

/* Infinite Rotation */
@keyframes rotate {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}
</style>
</head>

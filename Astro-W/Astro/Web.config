<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings file="App_Data/Prokerala.local.config">
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- Optional public OAuth settings. Private GOOGLE_CLIENT_SECRET is server environment only. -->
    <add key="Google:ClientId" value="" />
    <add key="Google:RedirectUri" value="" />
  </appSettings>
  <system.web>
	  <machineKey 
		  validationKey="1FBF63E1F7EAD1FF9D175EAF47F2B4868BC6F57A2FF7504FFD76228873BEC9C0F471D7162D08996563A53619BFADF43555CB6E5DFBDC3DB9AFCDF0B92CEC85CE" 
		  decryptionKey="9190AC3594A31464994BD4EE02948555B525EA000D1FFD7D927399004A1B153E" 
		  validation="SHA1" 
		  decryption="AES" />	  

    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="WindowsBase, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Management.Automation, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
        <add assembly="System.Numerics, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
		  <add assembly="System.Net.Http, Version=4.2.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" />
    <!-- Enable Forms Authentication -->
    <authentication mode="Forms">
      <forms name=".BharatAstro.Auth" defaultUrl="~/Default.aspx" loginUrl="~/Login.aspx"
             slidingExpiration="true" timeout="120" cookieless="UseCookies" cookieSameSite="Lax" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <customErrors mode="Off" defaultRedirect="GenericErrorPage.aspx">
      <error statusCode="404" redirect="error/404.aspx" />
      <error statusCode="500" redirect="error/500.aspx" />
    </customErrors>
  </system.web>
  <!-- Authentication entry points and static design assets are public. -->
  <location path="Login.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>
  <location path="assets">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>
  <location path="CreateAccount.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>
  <location path="GoogleCallback.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
  <connectionStrings>
    
  </connectionStrings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
